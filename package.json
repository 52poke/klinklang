{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preformat": "pnpm --filter @mudkipme/klinklang-domain build",
    "format": "oxlint --type-aware --fix .",
    "prelint": "pnpm --filter @mudkipme/klinklang-domain build",
    "lint": "oxlint --type-aware --report-unused-disable-directives .",
    "test": "pnpm run -r test",
    "start": "pnpm run -r --parallel start",
    "serve": "pnpm --filter @mudkipme/klinklang-server run --stream serve",
    "build": "pnpm run -r build"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
