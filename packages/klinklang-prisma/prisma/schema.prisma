datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Terminology {
  id        Int      @id @default(autoincrement())
  textId    Int
  category  String
  lang      String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  wikiId       BigInt        @unique
  groups       String[]
  token        Json          @db.JsonB
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workflows    Workflow[]
  fediAccounts FediAccount[]
}

model Workflow {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  isPrivate       Boolean
  enabled         Boolean
  triggers        Json               @db.JsonB
  definition      Json               @db.JsonB
  currentRevision Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  userId          String?            @db.Uuid
  user            User?              @relation(fields: [userId], references: [id])
  revisions       WorkflowRevision[]
}

model WorkflowRevision {
  workflowId       String   @db.Uuid
  revision         Int
  name             String
  isPrivate        Boolean
  enabled          Boolean
  triggers         Json     @db.JsonB
  definition       Json     @db.JsonB
  changeKind       String
  sourceWorkflowId String?  @db.Uuid
  sourceRevision   Int?
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  workflow         Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@id([workflowId, revision])
  @@index([workflowId, createdAt])
}

model FediInstance {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  domain       String        @unique
  clientID     String
  clientSecret String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     FediAccount[]
}

model FediAccount {
  id             String       @id @default(uuid()) @db.Uuid
  subject        String       @unique
  fediInstanceId String       @db.Uuid
  fediInstance   FediInstance @relation(fields: [fediInstanceId], references: [id])
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  accessToken    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
